{% extends 'base.html.twig' %}
{% block title %}Recipe
{% endblock %}
{% block body %}

	<h1>Recipe</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ recipe.id }}</td>
			</tr>
			<tr>
				<th>Name</th>
				<td>{{ recipe.name }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ recipe.description }}</td>
			</tr>
			<tr>
				<th>Season</th>
				<td>{{ recipe.season.label }}</td>
			</tr>
			<tr>
				<th>Time</th>
				<td>{{ recipe.time }}</td>
			</tr>
			<tr>
				<th>Level</th>
				<td>{{ recipe.level.label }}</td>
			</tr>
			<tr>
				<th>MainCategory</th>
				<td>{{ recipe.mainCategory.label }}</td>
			</tr>
		</tbody>
	</table>
	<div>
		<h2>材料</h2>
		<p>INGREDIENT POUR</p>

		<div>
			<button id="decrease-btn" type="button">−</button>
			<span id="person-count">1</span>
			<button id="increase-btn" type="button">＋</button>
			<span>PERSONNES</span>
		</div>


		<ul>
			{% for ri in recipe.recipeIngredients %}
				<li data-base-quantity="{{ ri.quantity }}">
					{{ ri.ingredient.name }}
					-
					<span class="quantity">{{ ri.quantity }}</span>
					{{ ri.unit }}
				</li>
			{% endfor %}
		</ul>
		<div>
			<h2>調味料</h2>
			<ul>
				{% for rc in recipe.recipeCondiments %}
					<li>
						{{ rc.condiment.name }}
						-
						{{ rc.quantity }}
						{{ rc.unit }}
						{# 
						   rc.condiment.condimentSubstituteGroups で、この調味料に紐づく、代替品グループを、すべて取得する

						   |length で、その、個数を、数える　> 0 で、「1つでも、あれば」という、条件にする
						   （代替品が、無い調味料には、ボタン自体を、表示しないため）
						#}
						{% if rc.condiment.condimentSubstituteGroups|length > 0 %}
							<button type="button" onclick="document.getElementById('dialog-{{ rc.condiment.id }}').showModal()">
								代用品を見る
							</button>

							<dialog id="dialog-{{ rc.condiment.id }}">
								<p>Pas de
									{{ rc.condiment.name }}？</p>
								<ul>
									{% for group in rc.condiment.condimentSubstituteGroups %}
										<li>
											{{ group.label }}
										</li>
									{% endfor %}
								</ul>
								<button type="button" onclick="document.getElementById('dialog-{{ rc.condiment.id }}').close()">
									閉じる
								</button>
							</dialog>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
</div>

<div>
	<h2>作り方</h2>
	<p>PRÉPARATION</p>
	<p>{{ recipe.step }}</p>
</div>

<a href="{{ path('app_recipe_index') }}">back to list</a>
{{ include('recipe/_delete_form.html.twig') }}{% endblock %}
