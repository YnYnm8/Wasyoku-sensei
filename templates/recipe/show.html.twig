{% extends 'base.html.twig' %}
{% block title %}Recipe{% endblock %}
{% block body %}

<h1>Recipe</h1>

<table class="table">
    <tbody>
        <tr>
            <th>Id</th>
            <td>{{ recipe.id }}</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>{{ recipe.name }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ recipe.description }}</td>
        </tr>
        <tr>
            <th>Season</th>
            <td>{{ recipe.season.label }}</td>
        </tr>
        <tr>
            <th>Time</th>
            <td>{{ recipe.time }}</td>
        </tr>
        <tr>
            <th>Level</th>
            <td>{{ recipe.level.label }}</td>
        </tr>
        <tr>
            <th>MainCategory</th>
            <td>{{ recipe.mainCategory.label }}</td>
        </tr>
    </tbody>
</table>
<div>
    <h2>材料</h2>
    <p>INGREDIENT POUR</p>

    <div>
        <button id="decrease-btn" type="button">−</button>
        <span id="person-count">1</span>
        <button id="increase-btn" type="button">＋</button>
        <span>PERSONNES</span>
    </div>
    

    <ul>
        {% for ri in recipe.recipeIngredients %}
            <li data-base-quantity="{{ ri.quantity }}">
                {{ ri.ingredient.name }} - 
                <span class="quantity">{{ ri.quantity }}</span> {{ ri.unit }}
            </li>
        {% endfor %}
    </ul>
    <div>
   
    <ul>
        {% for rc in recipe.recipeCondiments %}
            <li>
                <a href="{{ path('app_condiment_show', {'id': rc.condiment.id}) }}">
                    {{ rc.condiment.name }}
                </a>
                - {{ rc.quantity }} {{ rc.unit }}
            </li>
        {% endfor %}
    </ul>
</div>
</div>

<div>
    <h2>作り方</h2>
    <p>PRÉPARATION</p>
    <p>{{ recipe.step }}</p>
</div>

<a href="{{ path('app_recipe_index') }}">back to list</a>
{{ include('recipe/_delete_form.html.twig') }}

{% endblock %}