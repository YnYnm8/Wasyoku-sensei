<div class="card-popup !max-w-none !mx-0 !p-0 overflow-hidden flex flex-col relative">
	{% set photo = recipe.media|first %}
	{% if photo %}
		<img src="{{ photo.url }}" alt="{{ recipe.name }}" class="w-full h-48 object-cover">
	{% endif %}

	<div class="p-4 flex flex-col gap-2">
		<h3 class="font-display text-lg text-washoku-bg">{{ recipe.name }}</h3>
		<p class="text-sm text-gray-500">{{ recipe.time }}
			—
			{{ recipe.level.label }}</p>

		{# ログインしているユーザーにだけ、お気に入りボタンを表示する #}
		{% if app.user %}

			{# favoriteRecipeIds（コントローラーから渡された、お気に入り済みレシピIDの配列）の中に、
						               このカードのレシピIDが含まれているかどうかで、
						               「解除ボタン（塗りつぶしハート）」か「追加ボタン（枠線ハート）」かを切り替える #}
			{% if recipe.id in favoriteRecipeIds %}

				{# 既にお気に入り済みの場合：解除フォーム
								                   CSRFトークンのラベルは recipe.id ベースで発行し、
								                   FavoriteController の removeFavorite() と一致させる #}
				<form method="post" action="{{ path('app_favorite_remove', {id: recipe.id}) }}" class="absolute top-3 right-3">
					<input type="hidden" name="_token" value="{{ csrf_token('delete_favorite' ~ recipe.id) }}">
					<button type="submit" class="btn-icon-round">♥</button>
				</form>

			{% endif %}

		{% endif %}

		{# US6（買い物リスト機能）が実装されるまで、一時的に非表示にしていたが、
				           US6完成に伴い、有効化した #}
		{% if showShoppingListButton|default(false) %}
			<button type="button" class="btn-secondary">+ Ajouter à une liste</button>
		{% endif %}
		{# {% if showShoppingListButton %}
			<button type="button" class="btn-secondary">+ Ajouter à une liste</button>
		{% endif %} #}

		<a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn-secondary text-center">Voir la recette</a>
	</div>
</div>
