{% extends 'admin/base.html.twig' %}
{% set active_tab = 'recipes' %}

{% block title %}新しいレシピを作成{% endblock %}

{% block admin_breadcrumb %}
    <a href="{{ path('app_recipe_index') }}" class="text-washoku-inputtext hover:text-white text-sm">
        ‹ 新しいレシピを作成
    </a>
    <p class="text-xs text-gray-600 uppercase tracking-widest mt-1">Créer une recette</p>
{% endblock %}

{% block admin_body %}
    <div class="card-popup max-w-sm lg:max-w-4xl mb-8">
        <h2 class="font-display text-lg mb-4">基本情報・Informations</h2>
        {{ include('recipe/_form.html.twig', {'button_label': '保存する・Enregistrer'}) }}
    </div>
{% endblock %}