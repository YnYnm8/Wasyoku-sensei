
{% extends 'base.html.twig' %}
{% block title %}Recipe index
{% endblock %}
{% block body %}

	<div>
		<p>{{ totalCount }}</p>
		<p>RECETTE TOTAL</p>
		<p>全{{ totalCount }}品</p>
	</div>

<div class="grid grid-cols-3 gap-4">
    {% for recipe in recipes %}
        {% include 'recipe/_card.html.twig' with {
            recipe: recipe,
            favoriteRecipeIds: favoriteRecipeIds
        } %}
    {% else %}
        <p>no records found</p>
    {% endfor %}
</div>

	<div class="flex gap-2 justify-center mt-4">
		{% for i in 1..totalPages %}
			{# 1..totalPagesは、配列ではなく、「1から、totalPagesまでの数字を、その場で新しく作ってください」という指示です。 #}
			<a href="{{ path('app_recipe_index', {'page': i}) }}" class="{% if i == currentPage %}font-bold underline{% endif %}">
				{{ i }}
			</a>
		{% endfor %}
	</div>

	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('app_recipe_new') }}" class="btn-primary">
			+ Ajouter une nouvelle recette
		</a>
	{% endif %}

{% endblock %}
