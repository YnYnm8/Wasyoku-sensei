{% extends 'base.html.twig' %}

{% block title %}Recipe index
{% endblock %}

{% block body %}
	<h1>Recipe index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Step</th>
				<th>Season</th>
				<th>Time</th>
				<th>Level</th>
				<th>MainCategory</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for recipe in recipes %}
				<tr>
					<td>{{ recipe.id }}</td>
					<td>{{ recipe.name }}</td>
					<td>{{ recipe.step }}</td>
					<td>{{ recipe.season.label }}</td>
					<td>{{ recipe.time }}</td>
					<td>{{ recipe.level.label }}</td>
					<td>{{ recipe.mainCategory.label }}</td>
					<td>
						<a href="{{ path('app_recipe_show', {'id': recipe.id}) }}">show</a>
						<a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_recipe_new') }}">Create new</a>
{% endblock %}
