<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Wasyoku Sensei
			{% endblock %}
		</title>
		<meta name="description" content="{% block meta_description %}Wasyoku Sensei, l'art culinaire japonais à la maison : recettes washoku, guide des condiments, épiceries asiatiques et liste de courses.{% endblock %}">

		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		{% block header %}
			<header class="bg-washoku-bg text-washoku-cream px-6 py-6">
				<nav class="flex items-center justify-between">
					<a href="{{ path('app_home') }}" class="font-display text-2xl">Wasyoku Sensei</a>
					{{ include('_nav_menu.html.twig') }}
				</nav>
			</header>
		{% endblock %}
		{% block body %}{% endblock %}

		{% for favori in app.flashes('favori_added') %}
			<dialog id="favori-confirm-dialog">
				<div class="card-popup space-y-3">
					<div class="popup-icon-circle">♥</div>
					<p class="popup-title">お気に入りに追加</p>
					<p class="popup-subtitle">AJOUTÉ AU FAVORIS</p>
					<div class="popup-info-box flex items-center gap-3">
						<input type="checkbox" checked disabled class="w-4 h-4 accent-washoku-red">
						{% if favori.photoUrl %}
							<img src="{{ favori.photoUrl }}" alt="{{ favori.name }}" class="w-12 h-12 object-cover rounded-lg flex-shrink-0">
						{% endif %}
						<div class="flex-1">
							<p class="popup-info-value">{{ favori.name }}</p>
							<p class="text-xs text-gray-600">{{ favori.personCount }}
								personne(s)</p>
						</div>
						<span class="text-washoku-red">♥</span>
					</div>
					<a href="{{ path('app_favorite_index') }}" class="btn-primary block text-center">Voir mes favoris</a>
					<button type="button" onclick="document.getElementById('favori-confirm-dialog').close()" class="btn-secondary">Continuer</button>
				</div>
			</dialog>

			 <script>
												            function openFavoriDialog() {
												                document.getElementById('favori-confirm-dialog').showModal();
												            }
												            document.addEventListener('DOMContentLoaded', openFavoriDialog);
												            document.addEventListener('turbo:load', openFavoriDialog);
												        </script>
		{% endfor %}
		{% for sent in app.flashes('shopping_list_sent') %}
			<dialog id="shopping-list-sent-dialog">
				<div class="card-popup">
					<div class="popup-icon-circle">✉️</div>
					<p class="popup-title">メール送信しました</p>
					<p class="popup-subtitle">LE MAIL A ÉTÉ ENVOYÉ</p>
					<button type="button" onclick="document.getElementById('shopping-list-sent-dialog').close()" class="btn-secondary">Continuer</button>
				</div>
			</dialog>

			 <script>
												        function openShoppingListSentDialog() {
												            document.getElementById('shopping-list-sent-dialog').showModal();
												        }
												        document.addEventListener('DOMContentLoaded', openShoppingListSentDialog);
												        document.addEventListener('turbo:load', openShoppingListSentDialog);
												    </script>
		{% endfor %}
		<footer class="bg-washoku-bg text-washoku-inputtext text-center py-6 mt-8">
			<p class="font-display text-washoku-red">和 WASYOKU</p>
			<p class="text-xs">&copy;
				{{ "now"|date("Y") }}
				WASYOKU - Tous droits réservés.</p>
		</footer>
	</body>
</html>