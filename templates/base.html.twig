<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>
        {% block title %}Welcome!{% endblock %}
    </title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<header class="bg-washoku-bg text-washoku-cream px-6 py-6">
    <nav class="flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="font-display text-2xl">Wasyoku Sensei</a>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="flex items-center gap-4">
                <span class="text-washoku-inputtext text-sm">Admin</span>
                <a href="{{ path('app_recipe_index') }}" class="text-base hover:text-washoku-red transition">Recettes</a>
                <a href="{{ path('app_condiment_index') }}" class="text-base hover:text-washoku-red transition">Condiments</a>
            </div>
        {% endif %}

        {% if app.user %}
            <a href="{{ path('app_favorite_index') }}" class="text-base hover:text-washoku-red transition">Mes favoris</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="text-base hover:text-washoku-red transition">Se connecter</a>
        {% endif %}
    </nav>
</header>
    {% block body %}{% endblock %}

    {% for favori in app.flashes('favori_added') %}
        <dialog id="favori-confirm-dialog">
            <div class="card-popup">
                <p class="text-center">♥</p>
                <h3>Ajouté aux favoris</h3>
                <p>{{ favori.name }}</p>
                <a href="{{ path('app_favorite_index') }}" class="btn-primary">Voir mes favoris</a>
                <button type="button" onclick="document.getElementById('favori-confirm-dialog').close()" class="btn-secondary">Continuer</button>
            </div>
        </dialog>

        <script>
            function openFavoriDialog() {
                document.getElementById('favori-confirm-dialog').showModal();
            }
            document.addEventListener('DOMContentLoaded', openFavoriDialog);
            document.addEventListener('turbo:load', openFavoriDialog);
        </script>
    {% endfor %}
    {% for sent in app.flashes('shopping_list_sent') %}
    <dialog id="shopping-list-sent-dialog">
        <div class="card-popup">
            <p class="text-center">📧</p>
            <h3>メールの送信しました</h3>
            <p>Votre liste de courses a bien été envoyée.</p>
            <button type="button" onclick="document.getElementById('shopping-list-sent-dialog').close()" class="btn-primary">OK</button>
        </div>
    </dialog>

    <script>
        function openShoppingListSentDialog() {
            document.getElementById('shopping-list-sent-dialog').showModal();
        }
        document.addEventListener('DOMContentLoaded', openShoppingListSentDialog);
        document.addEventListener('turbo:load', openShoppingListSentDialog);
    </script>
{% endfor %}
   <footer class="bg-washoku-bg text-washoku-inputtext text-center py-6 mt-8">
    <p class="font-display text-washoku-red">和 WASYOKU</p>
    <p class="text-xs">&copy; {{ "now"|date("Y") }} WASYOKU - Tous droits réservés.</p>
</footer>
</body>
</html>