{% extends 'admin/base.html.twig' %}
{% set active_tab = 'condiments' %}

{% block title %}調味料管理{% endblock %}

{% block admin_breadcrumb %}
    <h2 class="font-display text-lg">調味料管理</h2>
    <p class="text-xs text-gray-400 uppercase tracking-widest mt-1">Gestion des condiments</p>
{% endblock %}

{% block admin_body %}
<div class="mb-6">
        <a href="{{ path('app_condiment_new') }}"
           class="inline-flex items-center gap-2 bg-washoku-red hover:bg-washoku-redhover text-white font-semibold rounded-lg px-14 py-3 text-base transition">
            <span class="text-xl leading-none">+</span> 
             新しい調味料を追加<br>    Ajouter un condiment         

        </a>
    </div>
   
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {% for condiment in condiments %}
            <div class="card-popup max-w-sm lg:max-w-none w-full flex gap-4 items-center lg:flex-col lg:items-start">

                <div class="w-20 h-20 lg:w-full lg:h-40 rounded-lg overflow-hidden bg-washoku-beige flex-shrink-0">
                    {% if condiment.imageUrl %}
                        <img src="{{ condiment.imageUrl }}" alt="{{ condiment.name }}" class="w-full h-full object-cover">
                    {% endif %}
                </div>

                <div class="flex-1 w-full">
                    <h3 class="font-display text-lg text-gray-800">{{ condiment.name }}</h3>
                    <p class="text-xs text-gray-500 mt-1 line-clamp-2">{{ condiment.explanation }}</p>

                    <div class="flex gap-2 mt-4">
                        <a href="{{ path('app_condiment_edit', {id: condiment.id}) }}"
                           class="flex-1 text-center px-4 py-2.5 rounded-lg text-sm font-semibold bg-washoku-beige text-gray-700 hover:opacity-80 transition">
                            編集・Éditer
                        </a>
                        <form method="post" action="{{ path('app_condiment_delete', {id: condiment.id}) }}" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ condiment.id) }}">
                            <button type="submit"
                                    onclick="return confirm('この調味料を削除しますか？')"
                                    class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold bg-washoku-red/10 text-washoku-red hover:bg-washoku-red/20 transition">
                                     削除・Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-washoku-inputtext">まだ調味料がありません。</p>
        {% endfor %}
    </div>

{% endblock %}