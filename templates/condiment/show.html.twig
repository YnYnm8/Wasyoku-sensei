{% extends 'base.html.twig' %}

{% block title %}Condiment
{% endblock %}

{% block body %}

	<img src="{{ condiment.imageUrl }}" alt="{{ condiment.name }}">
	<div>{{ condiment.name }}</div>

	<div>{{ condiment.explanation }}</div>

	<div>
		<h2>組成</h2>
		<p>COMPOSITION</p>

		<ul>
			<li>
				<div>{{ condiment.composition }}</div>
			</li>
		</ul>
	</div>

	<div>
		<h2>用途</h2>
		<p>UTILISATION</p>
		<ul>
			{% for rc in condiment.recipeCondiments %}
				<li>
					<a href="{{ path('app_recipe_show', {id: rc.recipe.id}) }}">
						{{ rc.recipe.name }}
					</a>
				</li>
			{% endfor %}
		</ul>

	</div>
	<div>
		<p>SUBSTITUTION・代用</p>
		{% if condiment.condimentSubstituteGroups|length > 0 %}
			{% for group in condiment.condimentSubstituteGroups %}
				<p>
					{% for substitute in group.condimentSubstitutes %}
						{{ substitute.name }}
						{{ substitute.quantity }}{{ substitute.unit }}
						{% if not loop.last %}
							+
						{% endif %}
					{% endfor %}
				</p>
			{% endfor %}
			<p>
				<em>Attention : l'utilisation d'un substitut peut légèrement modifier le goût authentique du plat.</em>
			</p>
		{% else %}
			<p>Aucun substitut disponible.</p>
		{% endif %}
	</div>

	<div>
		<p>OU L'ACHETER 購入</p>
		{% if condiment.url %}
			<a href="{{ condiment.url }}" target="_blank" rel="noopener noreferrer">
				Commander en ligne
			</a>
		{% endif %}
	</div>


	<a href="{{ path('app_condiment_index') }}">back to list</a>

	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('app_condiment_edit', {'id': condiment.id}) }}">Éditer</a>
	{% endif %}

	{% if is_granted('ROLE_ADMIN') %}
		{{ include('condiment/_delete_form.html.twig') }}
	{% endif %}

{% endblock %}
