{% extends 'base.html.twig' %}

{% block title %}
{{ condiment.name }}
{% endblock %}

{% block body %}

<img src="{{ condiment.imageUrl }}" alt="{{ condiment.name }}" class="w-full h-80 object-contain bg-washoku-cream">

<div class="p-4">
    <h1 class="font-display text-2xl">{{ condiment.name }}</h1>
    <p class="text-gray-600 mt-2">{{ condiment.explanation }}</p>

    <div class="mt-6">
        <div class="flex items-center justify-between">
            <h2 class="font-display text-lg">組成</h2>
            <span class="w-4 h-4 bg-washoku-red"></span>
        </div>
        <p class="text-sm text-gray-500">COMPOSITION</p>
        <span class="inline-block bg-washoku-beige text-gray-700 text-sm px-3 py-1 rounded-full mt-2">{{ condiment.composition }}</span>
    </div>

    <div class="mt-6">
        <div class="flex items-center justify-between">
            <h2 class="font-display text-lg">用途</h2>
            <span class="w-4 h-4 bg-washoku-red "></span>
        </div>
        <p class="text-sm text-gray-500">UTILISATION</p>
        <div class="flex flex-wrap gap-2 mt-2">
            {% for rc in condiment.recipeCondiments %}
                <a href="{{ path('app_recipe_show', {id: rc.recipe.id}) }}" class="bg-washoku-red text-white text-sm px-3 py-1 rounded-full">
                    {{ rc.recipe.name }}
                </a>
            {% endfor %}
        </div>
    </div>

    <div class="mt-6 bg-orange-50 border border-orange-200 rounded-2xl p-4">
        <p class="text-sm text-orange-600 font-semibold">SUBSTITUTION・代用</p>
        {% if condiment.condimentSubstituteGroups|length > 0 %}
            {% for group in condiment.condimentSubstituteGroups %}
                <p class="text-lg font-semibold mt-1">
                    {% for substitute in group.condimentSubstitutes %}
                        {{ substitute.name }}
                        {{ substitute.quantity }}{{ substitute.unit }}
                        {% if not loop.last %}
                            +
                        {% endif %}
                    {% endfor %}
                </p>
            {% endfor %}
            <p class="text-xs text-gray-500 mt-2">
                <em>Attention : l'utilisation d'un substitut peut légèrement modifier le goût authentique du plat.</em>
            </p>
        {% else %}
            <p class="mt-1">Aucun substitut disponible.</p>
        {% endif %}
    </div>

    <div class="mt-6">
        <p class="text-sm text-gray-500">OU L'ACHETER 購入</p>
        {% if condiment.url %}
            <a href="{{ condiment.url }}" target="_blank" rel="noopener noreferrer" class="btn-primary mt-2 inline-block !w-auto px-6">
                Commander en ligne
            </a>
        {% endif %}
    </div>

    <div class="mt-6">
        <p class="text-sm text-gray-500">MAGASIN PRÈS DE CHEZ VOUS 近くのお店</p>
        <a href="{{ path('app_asian_shop_index') }}" class="btn-secondary mt-2 inline-block !w-auto px-6">
            Chercher un magasin
        </a>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_condiment_edit', {'id': condiment.id}) }}" class="btn-secondary mt-2 inline-block !w-auto px-6">Éditer</a>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        {{ include('condiment/_delete_form.html.twig') }}
    {% endif %}
</div>
{% endblock %}