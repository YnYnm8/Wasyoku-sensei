<div class="card-popup !max-w-none !mx-0 !p-0 overflow-hidden flex flex-col">
    <img src="{{ condiment.imageUrl }}" alt="{{ condiment.name }}" loading="lazy" class="w-full h-48 object-cover">

    <div class="p-4 flex flex-col gap-2">
        <h3 class="font-display text-lg text-washoku-bg">{{ condiment.name }}</h3>
        <p class="text-sm text-gray-500">{{ condiment.explanation|slice(0, 40) }}...</p>
        <a href="{{ path('app_condiment_show', {'id': condiment.id}) }}" class="btn-secondary text-center">
            Voir le détail
        </a>
    </div>
</div>