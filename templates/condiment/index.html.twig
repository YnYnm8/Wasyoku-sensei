{% extends 'base.html.twig' %}

{% block title %}Condiment index
{% endblock %}

{% block body %}
	<div>
		<p>{{totalCount}}</p>
		<p>CONDIMENT TOTAL</p>
		<p>全{{ totalCount }}品</p>
	</div>


	<div class="grid grid-cols-3 gap-4">
		{% for condiment in condiments %}
			{% include 'condiment/_condiment_card.html.twig' with {
            condiment: condiment
        } %}
		{% else %}
			<p>Aucun condiment trouvé.</p>
		{% endfor %}
	</div>

	<div class="flex gap-2 justify-center mt-4">
		{% for i in 1..totalPages %}
			<a href="{{ path('app_condiment_index', {'page': i}) }}" class="{% if i == currentPage %}font-bold underline{% endif %}">
				{{ i }}
			</a>
		
	{% endfor %}
</div>

{% if is_granted('ROLE_ADMIN') %}
	<a href="{{ path('app_condiment_new') }}" class="btn-primary">
		+ Ajouter un nouveau condiment
	</a>
{% endif %}{% endblock %}
