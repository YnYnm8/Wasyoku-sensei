{% extends 'base.html.twig' %}

{% block title %}Guide des condiments{% endblock %}

{% block body %}
<div class="p-4">
    <p class="text-2xl font-display">{{ totalCount }}</p>
    <p class="text-sm text-gray-500">CONDIMENT TOTAL</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
        {% for condiment in condiments %}
            {% include 'condiment/_condiment_card.html.twig' with {
                condiment: condiment
            } %}
        {% else %}
            <p>Aucun condiment trouvé.</p>
        {% endfor %}
    </div>

    <div class="flex gap-2 justify-center mt-6">
        {% for i in 1..totalPages %}
            <a href="{{ path('app_condiment_index', {'page': i}) }}" class="w-8 h-8 flex items-center justify-center rounded-full {% if i == currentPage %}bg-washoku-red text-white{% else %}text-gray-500{% endif %}">
                {{ i }}
            </a>
        {% endfor %}
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_condiment_new') }}" class="btn-primary mt-4">
            + Ajouter un nouveau condiment
        </a>
    {% endif %}
</div>
{% endblock %}