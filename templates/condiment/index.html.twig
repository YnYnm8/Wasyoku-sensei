{% extends 'base.html.twig' %}

{% block title %}Guide des condiments
{% endblock %}

{% block body %}

	<div class="px-6 pb-6">
		<div class="flex items-center justify-between">
			<h2 class="font-display text-xl">調味料</h2>
			<span class="w-4 h-4 bg-washoku-red "></span>
		</div>
		<p class="text-xs text-gray-600 uppercase tracking-widest mt-1">Condiment</p>
		<p class="text-2xl font-display"></p>
		<p class="font-display text-ml">CONDIMENT TOTAL
			{{ totalCount }}</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
		{% for condiment in condiments %}
			{% include 'condiment/_condiment_card.html.twig' with {
                condiment: condiment
            } %}
		{% else %}
			<p>Aucun condiment trouvé.</p>
		{% endfor %}
	</div>

	<div class="flex gap-2 justify-center mt-4">
    {% for i in 1..totalPages %}
        {# 1..totalPagesは、配列ではなく、「1から、totalPagesまでの数字を、その場で新しく作ってください」という指示です。 #}
        <a href="{{ path('app_recipe_index', {'page': i}) }}"
           class="w-10 h-10 flex items-center justify-center rounded-xl font-semibold transition
                  {% if i == currentPage %}
                      bg-washoku-red text-white
                  {% else %}
                      bg-white border border-washoku-beige text-gray-700 hover:bg-washoku-cream
                  {% endif %}">
            {{ i }}
        </a>
    {% endfor %}

    {% if currentPage < totalPages %}
        <a href="{{ path('app_recipe_index', {'page': currentPage + 1}) }}"
           class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-washoku-beige text-gray-700 hover:bg-washoku-cream transition">
            ›
        </a>
    {% endif %}
</div>

	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('app_condiment_new') }}" class="btn-primary mt-4">
			+ Ajouter un nouveau condiment
		</a>
	{% endif %}
</div>{% endblock %}
