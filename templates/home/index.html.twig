{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		{% if app.user %}
			<h1>ようこそ！{{ app.user.username }}さん</h1>
		{% else %}
			<h1>ようこそ！</h1>
		{% endif %}
		{# 食材で探す #}
		<h2>PAR INGRÉDIENTS</h2>
		<form method="get" action="{{ path('app_recipe_index') }}">
			<input type="text" name="ingredients" placeholder="Rechercher un ingrédient, une recette...">
			<button type="submit" class="btn-primary">Rechercher</button>
		</form>

		{# 主食材で探す（クイック検索ボタン） #}
		<h2>PAR INGRÉDIENT PRINCIPAL</h2>
		<a href="{{ path('app_recipe_index', {'mainCategory': 'meat'}) }}">Viande</a>
		<a href="{{ path('app_recipe_index', {'mainCategory': 'fish'}) }}">Poisson</a>
		<a href="{{ path('app_recipe_index', {'mainCategory': 'tofu'}) }}">Tofu</a>
		<a href="{{ path('app_recipe_index', {'mainCategory': 'vegetable'}) }}">Légumes</a>

		{# 難易度で探す #}
		<h2>PAR DIFFICULTÉ</h2>
		<a href="{{ path('app_recipe_index', {'level': 'easy'}) }}">Facile</a>
		<a href="{{ path('app_recipe_index', {'level': 'medium'}) }}">Moyen</a>
		<a href="{{ path('app_recipe_index', {'level': 'hard'}) }}">Difficile</a>
		<div>

			<a href="{{ path('app_recipe_index') }}" class="btn-primary">Aller voir toutes les recettes</a>
		</div>
	</div>
	<h2>RECETTES POPULAIRES</h2>
	<p>人気のレシピ</p>

	<div class="grid grid-cols-1 gap-4">
		{% for recipe in recipes %}
			{% include 'recipe/_card.html.twig' with {
            recipe: recipe,
            favoriteRecipeIds: favoriteRecipeIds
        } %}
		{% else %}
			<p>まだ、レシピがありません。</p>
		{% endfor %}
	</div>
	<div>

		<a href="{{ path('app_condiment_index') }}" class="btn-primary">Guide des condiments</a>

	</div>
{% endblock %}
