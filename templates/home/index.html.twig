{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	
<div class="p-6 space-y-8">
    <h1 class="font-display text-2xl">ようこそ！{{ app.user.username }}さん</h1>

    {# 食材で探す #}
    <div>
        <h2 class="font-display text-lg">PAR INGRÉDIENTS</h2>
        <p class="text-sm text-gray-500">食材で探す</p>
        <form method="get" action="{{ path('app_recipe_index') }}" class="flex gap-2 mt-2">
            <input type="text" name="ingredients" placeholder="Rechercher un ingrédient, une recette..." class="flex-1 border border-washoku-beige rounded-lg px-3 py-2">
            <button type="submit" class="btn-primary !w-auto px-6">Rechercher</button>
        </form>
    </div>

    {# 主食材で探す #}
    <div>
        <h2 class="font-display text-lg">PAR INGRÉDIENT PRINCIPAL</h2>
        <p class="text-sm text-gray-500">主食材で探す</p>
        <div class="flex gap-2 mt-2">
            <a href="{{ path('app_recipe_index', {'mainCategory': 'meat'}) }}" class="btn-secondary !w-auto px-4">Viande</a>
            <a href="{{ path('app_recipe_index', {'mainCategory': 'fish'}) }}" class="btn-secondary !w-auto px-4">Poisson</a>
            <a href="{{ path('app_recipe_index', {'mainCategory': 'tofu'}) }}" class="btn-secondary !w-auto px-4">Tofu</a>
            <a href="{{ path('app_recipe_index', {'mainCategory': 'vegetable'}) }}" class="btn-secondary !w-auto px-4">Légumes</a>
        </div>
    </div>

    {# 難易度で探す #}
    <div>
        <h2 class="font-display text-lg">PAR DIFFICULTÉ</h2>
        <p class="text-sm text-gray-500">難易度で探す</p>
        <div class="flex gap-2 mt-2">
            <a href="{{ path('app_recipe_index', {'level': 'easy'}) }}" class="btn-secondary !w-auto px-4">Facile</a>
            <a href="{{ path('app_recipe_index', {'level': 'medium'}) }}" class="btn-secondary !w-auto px-4">Moyen</a>
            <a href="{{ path('app_recipe_index', {'level': 'hard'}) }}" class="btn-secondary !w-auto px-4">Difficile</a>
        </div>
    </div>

    <a href="{{ path('app_recipe_index') }}" class="btn-primary block text-center">Aller voir toutes les recettes</a>
</div>
	<h2>PRESQUE POPULAIRES</h2>
<p>人気のレシピ</p>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4">
    {% for recipe in recipes %}
        {% include 'recipe/_card.html.twig' with {
            recipe: recipe,
            favoriteRecipeIds: favoriteRecipeIds
        } %}
    {% else %}
        <p>まだ、レシピがありません。</p>
    {% endfor %}
</div>
	<div>

		<a href="{{ path('app_condiment_index') }}" class="btn-primary">Guide des condiments</a>

	</div>
{% endblock %}
